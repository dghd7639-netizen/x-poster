{
  "mcpServers": {
    "x-poster": {
      "command": "node",
      "args": ["server/index.mjs"],
      "cwd": ".",
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 300,
      "env_vars": ["X_POSTER_HOME", "X_POSTER_CHROME_PATH", "X_POSTER_HEADLESS", "X_POSTER_MIN_INTERVAL_SEC", "X_POSTER_DAILY_LIMIT"],
      "tools": { "x_post": { "approval_mode": "prompt" } }
    }
  }
}
